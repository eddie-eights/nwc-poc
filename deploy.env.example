# ops/up.sh / ops/down.sh の設定の見本。cp deploy.env.example deploy.env で写して書く（deploy.env は配布物には入っていない）。
#
# .env.example との違い: こちらは「**何を作るか**」の設定で、Terraform に渡る。
# .env.example は「**動いているプログラムが読む値**」（リージョン・表の名前・タイトルなど）で、AWS 上では Terraform が渡すので手で用意しない。
#
# **必須なのは OWNER（デプロイする人の名前）だけ**で、ほかは全部任意（無い行・値が空の行は下の「既定」のまま。既定は土台だけを作る）。
# 各行の頭に「既定 …」を書いてある。行のコメントを外して値を変えたときだけ、そちらが使われる。
# 同じ名前の環境変数が空でなければ、そちらがこのファイルより優先する（PIPELINE=1 ops/up.sh）。
# シェルとしては実行しない（$HOME や $(…) は展開せず、値の先頭の ~/ だけ読み替える）。値が空の行は書いていないのと同じ。
# ここに書くのは「どの機能を作るか」と手元の環境のことだけ。アカウント ID や ARN や認証情報は書かない（docs/deploy.md）。

# OWNER = デプロイする人の名前。**必須**（書かないと ops/up.sh も ops/down.sh も先頭で止まる）。一番下の OWNER= の右に自分の名前を書く（見本の yamada は下の説明のとおりの形）。
# 英小文字で始まる 14 文字までの英小文字・数字・ハイフン（ハイフンは連続させず末尾にも置かない）。
# 1 つの AWS アカウントを何人かで使うときに、自分の名前で自分のリソースを探せるようにするための値。
#   リソース名と SSM のパスと Project タグの接頭辞は、この名前から <owner>-nwc-poc になる（yamada なら yamada-nwc-poc）。
#   接頭辞はリソース名（yamada-nwc-poc-vpc / yamada-nwc-poc-agent …）、SSM のパス（/yamada-nwc-poc/…）、Project タグ、
#   ECR のリポジトリ名、EC2 の systemd ユニット名に入る。owner タグには OWNER がそのまま入る。
#   AgentCore Runtime の名前だけはハイフンが使えないので、- を _ にした <接頭辞>_agent（yamada → yamada_nwc_poc_agent）になる。
#   14 文字なのは、接頭辞が OpenSearch Serverless の data access policy 名の 32 文字（一番長い接尾辞は <接頭辞>-logs-read の 10 文字）に収まる長さだから。
#   ハイフンの制限は ECR のリポジトリ名
# **作ったあとで変えない。**名前が変わったリソースを Terraform は「別のもの」と見るので、打ち直すと全部作り直しになる（先に ops/down.sh で消してから変える）。
# ops/down.sh も同じ deploy.env を読むので、ここを書き換えずに打てば消す相手は自動で揃う。
OWNER=

# どの機能を作るか（1 / 0。既定は AGENT=0 / PIPELINE=0 / WORKFLOW=0 = 土台だけ）。
# 土台（base/ecr + base/core: VPC / Web の EC2 / バケット / ロール。約 $0.02/h + エンドポイント。インターネットへの経路は無い）は必ず作る。
# 機能は互いに独立で、要るものだけ 1 にする。あとから別の機能を 1 にして ops/up.sh を打ち直せば、その機能だけ足される（土台と他の機能は作り直さない）。
#   AGENT     agent での分析。AgentCore Runtime + ガードレール。Web の「チャット」タブが使える（0 だと Web は開けるが、チャットは「配備されていない」と返す）。待機の費用は 0（質問ごとのモデル料金だけ）
#   PIPELINE  データパイプライン。lab（containerlab の EC2）→ stream（MSK と Telegraf の ECS）→ analytics（Spark → S3 Tables / OpenSearch / Prometheus / Splunk と Grafana。Grafana のアラートルールと
#             Splunk の保存済みサーチが異常を見つけて SNS のトピック <接頭辞>-alerts に出す）と graph（Neptune。アラートで機器・回線の status が変わる）。Web の「トポロジ」タブが動く。約 $2.80/h（STORES が既定の s3,grafana,splunk のとき。STORES=s3 なら約 $1.86/h、SKIP_* でさらに減らせる）
#   WORKFLOW  Temporal での実行。workflow（Temporal on ECS Fargate のワーカー + AgentCore Gateway（MCP）+ SNS → SQS）。Grafana / Splunk のアラートが SQS で届き、
#             エージェントが Neptune / OpenSearch / Prometheus を見て原因を調べて修復案を出し、人が Web の「承認」タブで承認すると Temporal が lab で直して確かめる。
#             AGENT と PIPELINE（lab / stream / analytics / graph）が要るので、WORKFLOW=1 なら両方 1 にし、SKIP_LAB / SKIP_STREAM / SKIP_ANALYTICS / SKIP_GRAPH は書けない。
#             link_down のアラートの送り手も要る: Grafana のアラート（STORES の grafana と SNMP_POLL=1）か Splunk（STORES の splunk）。どれも既定。両方無いと ops/up.sh が止まる。約 $0.09/h
AGENT=0
PIPELINE=0
WORKFLOW=0

# AGENT=1 で Knowledge Base（S3 の md → Titan Embeddings → OpenSearch Serverless）も作る。**既定 0 = 作らない**（エージェントはモデルとツールだけで答える）。
# 作ると +$0.37/h（OCU 1 つ・スタンバイ無しの $0.33 と、OpenSearch Serverless の VPC エンドポイント $0.03、bedrock-agent-runtime のエンドポイント）
#CREATE_KB=0

# PIPELINE=1 で一部のルートを作らない（**既定は 4 つとも 0 = 全部作る**。ファイルの 1 をその回だけ打ち消すなら SKIP_GRAPH=0 ops/up.sh）
#SKIP_LAB=1          # lab を作らない。約 $0.17/h 下がる。ほかは lab が無くても作れる。stream を作れば Telegraf の取りにいく側は lab の定義の機器を探しに行き、
#                    # 届かないのでエラーをログに出して繋ぎ直し続ける（タスクは落ちない）。graph には lab のトポロジを入れない（Nautobot の Job が書く物理層だけ）
#SKIP_STREAM=1       # stream（MSK と Telegraf の ECS）を作らない。analytics も作らない（アラートは出ない）。約 $1.80/h 下がる（STORES が既定のとき）
#SKIP_ANALYTICS=1    # analytics（EMR Serverless の Spark と STORES の格納先、Grafana / Splunk とそのアラート）を作らない。約 $1.18/h 下がる（STORES が既定のとき）
#SKIP_GRAPH=1        # graph（Neptune Analytics）を作らない。約 $0.60/h 下がる。「トポロジ」タブはファイルで定義した静的データを出す。アラートが届いても status を書く先が無い

# analytics の格納先を 3 つのまとまりで選ぶ。**既定は s3,grafana,splunk = 3 つとも**（書かないときも、空のときもこれ）。格納先を選ぶキーはこれだけ。
# まとまりをカンマで並べる（例 STORES=s3,grafana。順番と重複は問わない）。書かなかったまとまりは作らない。知らない名前と空の要素（s3,,splunk）は止まる。
# Spark のジョブはまとまりごとに 1 つで、1 つ $0.21/h（EMR Serverless の 3 vCPU）。下の費用はそれを含み、PIPELINE=1 で analytics を作るときだけ掛かる。
#   s3       全トピック → S3 Tables（Iceberg）のテーブル raw_telemetry。+$0.21/h（ジョブの分だけ。テーブルは無料）。
#            外すと生データが S3 Tables に残らない
#   grafana  traps と logs（logs は機器の syslog）→ OpenSearch Serverless の TIMESERIES コレクション <prefix>-logs（VPC の中からだけ届く）、
#            metrics と gnmi → Amazon Managed Service for Prometheus のワークスペース <prefix>-metrics と、
#            その 2 つを見る Grafana OSS（analytics の ECS。Fargate ARM 0.5 vCPU / 1 GB）。約 +$0.62/h（ジョブ $0.21、OpenSearch の OCU 最大 $0.33、
#            Grafana $0.02、エンドポイント（OpenSearch Serverless の $0.03 と、aps-workspaces と sns の $0.014 ずつ。sns は splunk と共用）。Prometheus は取り込みのサンプル課金が別）。
#            OCU が Knowledge Base（CREATE_KB=1）のコレクションと共有されるかは未確認で、共有されなくても入れる（最大 $0.33/h は承知のうえ）。
#            Grafana は web の EC2 を踏み台にした SSM のポートフォワードで http://localhost:3000/ を開く。admin のパスワードは ops/up.sh が
#            SSM の SecureString に乱数で作る（コマンドは ops/up.sh の最後に出る）。アラートルールも入り、見つけた異常を
#            SNS のトピック <接頭辞>-alerts に出す。Prometheus の link_down（SNMP のポーリングの ifOperStatus）・bgp_down / isis_down（gNMI）と、
#            OpenSearch の trap（linkDown / linkUp 以外の trap）。link_down は下の SNMP_POLL=0 では発火しない。
#            外すと、エージェントの search_logs / query_metrics は格納先が無いので「配備されていない」を返し、Grafana の画面とアラートルールも無くなる
#   splunk   全トピック → Splunk の HTTP Event Collector（HEC）。Splunk Enterprise（公式イメージ splunk/splunk に検知の app（splunk/netops_alerts）を
#            足したもの・試用ライセンス）を analytics の ECS（Fargate x86 2 vCPU / 4 GB）で立て、VPC の中で送る。
#            約 +$0.34/h（ジョブ $0.21、Splunk $0.12、sns のエンドポイント $0.014。sns は grafana と共用）。
#            保存済みサーチ（ポーリングの ifOperStatus、trap の linkDown / linkUp、gNMI の BGP / IS-IS、そのほかの trap）が毎分走り、見つけた異常を SNS のトピック <接頭辞>-alerts に出す。
#            **起動時に Splunk のライセンスと Splunk General Terms に同意する**。管理者のパスワードと HEC の token は ops/up.sh が
#            SSM の SecureString に乱数で作り（値は出さない）、ops/down.sh が消す。index はタスクと一緒に消える（検証用）。
#            画面は web の EC2 を踏み台にした SSM のポートフォワードで開く（コマンドとパスワードを見るコマンドは ops/up.sh の最後に出る）。
#            外すと、trap の linkDown / linkUp から IF の up / down を知らせるものが無い（SNMP_POLL=1 なら grafana の link_down がポーリングから知らせる）。AWS の外の Splunk へ NAT Gateway で送る道は 2026-09-28 にやめた
# **前に作ったまとまりを外して ops/up.sh を打ち直すと、その格納先はデータごと消える**（s3 は S3 Tables のテーブル raw_telemetry の中身、
# grafana は OpenSearch のコレクションと Prometheus のワークスペース、splunk は Splunk の index）。
# 前の SINK_S3 / SINK_OPENSEARCH / SINK_PROMETHEUS / SINK_SPLUNK / GRAFANA は 2026-10-04 になくした。残っていると ops/up.sh が、
# その値に当たる STORES の書き方を出して止まる（消して STORES を書く）
#STORES=s3,grafana,splunk

# STORES に splunk を入れたときに送る index。**既定は空** = HEC の token の既定の index
#SPLUNK_INDEX=

# Spark のジョブが HTTP の格納先（OpenSearch / Prometheus / Splunk）へ送る所。**既定 driver** = マイクロバッチを driver に集めて送る（PoC の量なら足りる）。
# executor = 集めずにパーティションごとに executor が送る（量が増えたとき用。費用は変わらない）。変えて ops/up.sh を打ち直すと Spark のジョブが起こし直される。
# executor でも Prometheus は送る前に系列（measurement と tags）で分け直し、同じ系列を 1 つのタスクが時刻の順に送る（Telegraf は Kafka のキーを付けないので、
# そのままだと系列がパーティションに散らばり、古い時刻のサンプルが拒まれる）。4xx で捨てた数は driver のログ（CloudWatch Logs）、理由は executor の stderr（S3 の logs）
#HTTP_SEND=driver

# Spark の 1 つのクエリが Kafka の 1 回のトリガー（60 秒）に読む件数の上限（全パーティションの合計。maxOffsetsPerTrigger）。**既定 10000**、0 で上限なし。
# ふだんの 60 秒分より十分大きいので、いつもは何も抑えない。効くのは止めていたジョブを起こし直した直後と、最初にトピックの頭から読むとき
# （HTTP の格納先は 1 回分を driver（2g）に集めて送るので、溜まった分を一度に読まないようにする）。
# 格納先ごとの MAX_OFFSETS_PER_TRIGGER_<格納先> を書くと、その格納先のクエリだけ上書きする（**既定は空** = 上の値。0 でそのクエリだけ上限なし）。
# 格納先の名前は Spark の呼び名（S3 は ICEBERG）。OpenSearch と Prometheus は同じジョブだがクエリは別なので、別の値が効く。
# 変えて ops/up.sh を打ち直すと、値が変わった格納先のジョブだけ起こし直される
#MAX_OFFSETS_PER_TRIGGER=10000
#MAX_OFFSETS_PER_TRIGGER_ICEBERG=
#MAX_OFFSETS_PER_TRIGGER_SPLUNK=
#MAX_OFFSETS_PER_TRIGGER_OPENSEARCH=
#MAX_OFFSETS_PER_TRIGGER_PROMETHEUS=

# Nautobot（terraform/pipeline/nautobot。ECS Fargate ARM 2 vCPU / 4 GB の web + Celery worker + Redis と、RDS の PostgreSQL db.t4g.micro。+$0.13/h と ecs のエンドポイント）は **PIPELINE=1 ならいつも作る**（切り替えるキーは無い）。
# 機器の一覧とケーブルの正は Nautobot。最初だけ lab の定義から入り、あとは Nautobot で機器・Service（gnmi / snmp）・ケーブルを変えるたびに、
# Nautobot の Job が Telegraf の取りにいく側（dialin）の機器の一覧（SSM のパラメータ）を書き換えてサービスを作り直し、Neptune の物理層を openCypher で合わせる。
# Job の書き先が要るので、SKIP_STREAM と SKIP_GRAPH の両方を書いたときだけ作らない。管理者のパスワード・SECRET_KEY・DB のパスワードは ops/up.sh が SSM の SecureString に乱数で作る（値は出さない）。
# 画面は web の EC2 を踏み台にした SSM のポートフォワードで http://localhost:8081/ を開く（コマンドは ops/up.sh の最後に出る）。
# ops/down.sh で DB ごと消える（Nautobot で編集した内容は残らない）。デバッグ用の EC2（ops/lab-debug.sh）は Nautobot を使わない

# stream の Telegraf（ECS）が受ける機器の syslog の形式。**既定 RFC3164**（本番の Cisco IOS の BSD 形式）。RFC3164 か RFC5424 だけ書ける。
# lab の SR Linux は RFC5424 で送る（ops/lab-common.sh の LAB_SYSLOG_STANDARD）ので、既定のままだと lab のログの項目（ホスト名・本文など）が崩れる
# （ops/up.sh が注意を出す）。lab のログまで見るなら RFC5424 にする。
# デバッグ用の EC2（ops/lab-debug.sh。ops/up.sh とは別に作る）の Telegraf は lab 専用なので、この値によらず RFC5424。変えて ops/up.sh を打ち直すと Telegraf のタスクが入れ替わる
#SYSLOG_STANDARD=RFC5424

# stream の Telegraf（ECS）で SNMP をポーリングするか。**既定 1 = する**（0 なら SNMP は機器からの trap だけ受ける）。
# 10 秒ごとに ifTable（IF の up / down・送受信のバイト数とエラー数）を取って metrics トピックに出す。
# Grafana のアラートルール link_down、Splunk の保存済みサーチ netops_poll、IF のグラフ、エージェントの IF のメトリクスはこのポーリングを見るので、0 では空になる。
# 0 で IF の up / down を知らせるのは STORES の splunk の Splunk（trap の linkDown / linkUp）だけ。WORKFLOW=1 は STORES の splunk か、STORES の grafana と SNMP_POLL=1 が要る。
# 変えて ops/up.sh を打ち直すと Telegraf のタスクが入れ替わる（費用は変わらない）
#SNMP_POLL=0

# コンテナイメージ（エージェント。WORKFLOW=1 ではワーカーも）のタグ。**既定 v1**。
# agent/ や workflow/ を変えたら v2 などに書き換える（ECR のタグは上書きできない）。ECR にそのタグが無いときだけビルドして push する
#IMAGE_TAG=v1

# terraform/base/core の vpc_cidr（社内と重なるとき）。**既定は 10.0.0.0/16**（/24 のプライベートサブネットを 2 つ切る）
#VPC_CIDR=10.0.0.0/16

# Cisco の MDT（telemetry の dial-out。tcp 57000）を stream の Telegraf の NLB へ送ってよい機器の CIDR（カンマで）。terraform/base/core の mdt_source_cidrs。
# **既定は空**で、どこからも受けない（lab の SR Linux は MDT を送れない）。0.0.0.0/0 は書けない（docs/collection.md）
#MDT_SOURCE_CIDRS=10.10.0.0/16,10.20.0.0/16

# 社内の SSL 検査の CA の PEM。**既定は空**（検査が無い環境では要らない）。AWS CLI と terraform がそのまま読む。下の値は書き方の見本
#AWS_CA_BUNDLE=~/certs/corp-ca.pem

# Web への SSM ポートフォワーディングの PC 側のポート（**既定 8080**）。NO_DASHBOARD_PORTFORWARD は**既定 0**で、1 なら開かずに終わる
# （2026-10-04 に NO_PORTFORWARD から名前を変えた。前の名前が残っていると ops/up.sh が止まる）
#LOCAL_PORT=8080
#NO_DASHBOARD_PORTFORWARD=1

# ops/down.sh で ECR（イメージ）を残すか。1 = 残す（次回の ops/up.sh がビルドを飛ばせる。保管料は月数円）、**0 = 消す（既定）**。ops/up.sh は見ない
#KEEP_ECR=0

# AWS CLI と terraform のプロファイル（aws login で入っているときに書く）。**既定は空 = 環境の AWS_PROFILE をそのまま使う**
#AWS_PROFILE=

# ---- 冗長化用（既定はどれも 1 AZ / 1 台。本番の形を試すときに書く） ----
# リソースごとに 1 つのキーで、1 にしたものだけ本番の形にする（費用はそのリソースの分だけ増える）。PoC のふだんの検証では書かない
#
# インターフェース型エンドポイントを 2 AZ（サブネット a と b）に置く。片方の AZ が止まっても、もう片方の AZ のタスクや EC2 は AWS の API に届く。エンドポイントの費用が倍。
# **既定 0** = サブネット a だけ
#ENDPOINTS_MULTI_AZ=1

# ---- デバッグ用（ふだんは書かない） ----
# 問題を切り分けるときだけ書き、済んだら消す（NETWORK_PERIMETER は消したあと ops/up.sh を打ち直して Deny を戻す）
#
# AccessDenied の切り分け: 拒んでいるのが閉域の Deny か、IAM の権限の不足かを分ける（docs/troubleshooting.md）。**既定 1**、0 で Deny を外す（エンドポイントは作る）。
# 閉域 = AWS の API は全部 VPC のインターフェース型エンドポイントを通し、通らない呼び出しを IAM とリソースポリシーの Deny で拒む。
# インターネットへの経路は無い（NAT Gateway も IGW も作らない）ので、エンドポイントが無い API は Deny より先に接続のタイムアウトになる。ops/lab-debug.sh もこのキーを読む
#NETWORK_PERIMETER=0
#
# terraform の失敗・遅さの切り分け: 出力を全部そのまま画面に出す。**既定 0** = Plan / できた（消えた）リソース / 5 分ごとの経過 / エラーだけを出す。
# どちらでも全文は ops/logs/tf-<ルート>-apply.log（destroy.log）に残るので、あとから見るだけならそのログでよい。ops/down.sh も読む
#TF_VERBOSE=0
