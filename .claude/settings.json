{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/cycle-context.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
