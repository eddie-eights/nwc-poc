@version: 4.26
# syslog-ng（AxoSyslog）の設定テンプレート（cycle 012。それまでは Telegraf の inputs.syslog が受けていた）。syslog-ng のコンテナ（IaC/terraform/aws-managed/pipeline/stream の ECS。
# docker/images/syslog-ng/Dockerfile）が起きるとき、syslog-ng.sh render がタスク定義の環境変数で __X__ を埋めて /tmp/syslog-ng.conf に書く。
# 流れ: 機器の syslog を udp 5140 で受ける → Kafka の logs トピックへ、Telegraf の inputs.syslog（+ processors.rename で hostname → sysName）と同じ JSON の形（device_log）で書く。
#   Spark（app/spark/snmp_sinks.py の read_rows）・Grafana の logs のダッシュボード・Splunk の保存済みサーチは Telegraf のときのまま読める。
#   キーと型は Telegraf 1.40.1 の実物の 1 行（docs/collection.md）と同じ。tests/test_collectors.py が下の format-json と突き合わせる
# Kafka の認証は「>>> kafka_auth scram」の区間（MSK の SASL/SCRAM。9096、TLS）。KAFKA_AUTH=none（OSS 版の ECS の Kafka と手元の compose）のとき syslog-ng.sh render が消す。
# ユーザー名とパスワードはここに埋めない。syslog-ng が設定を読むときに環境変数 KAFKA_SASL_USER / KAFKA_SASL_PASS から入れる（名前をバッククォートで囲む書き方。/tmp の設定に値が残らない）。
# ECS は Secrets Manager の AmazonMSK_<接頭辞>-syslog-ng を secrets で受ける。値に二重引用符・バックスラッシュ・バッククォート・空白は使えない（設定の文字列が壊れる。syslog-ng.sh render が止める）。
# syslog-ng はバッククォートをコメントの中でも展開する（閉じていないと設定が読めない）ので、このファイルにはバッククォートを 2 か所のほかに書かない

options {
  # HOST は機器が名乗る名前（SR Linux の host-name = sysName）のまま。DNS は引かない
  keep-hostname(yes);
  use-dns(no);
  use-fqdn(no);
  chain-hostnames(no);
  # 定期の統計をログに出さない
  stats(freq(0));
};

# ---- 機器のログ。ポートは app/containerlab/lab.sh の LOG_PORT と同じ 5140。lab の EC2 が 203.0.113.1:5140 宛てを NLB へ DNAT し、NLB がここへ渡す（送り元は機器の管理 IP のまま）。
# 形式は syslog-ng.sh render が SYSLOG_STANDARD で flags を埋める（RFC5424 = flags(syslog-protocol)、RFC3164 = 無し。既定 RFC3164 = 本番の Cisco IOS の BSD 形式）。
# 同じ番号の tcp は NLB のヘルスチェック（UDP の target group は TCP で見る）が開く口。tcp で来た syslog も同じように Kafka へ書く
source s_device {
  network(transport("udp") ip("__BIND__") port(__LOG_PORT__) __SYSLOG_FLAGS__);
  network(transport("tcp") ip("__BIND__") port(__LOG_PORT__) __SYSLOG_FLAGS__);
};

# ---- Kafka の logs トピックへ（kafka-c() = librdkafka）。MSK では、トピックと SCRAM のユーザーの ACL（WRITE / DESCRIBE）は Spark が起動時に入れる
# （app/spark/snmp_sinks.py の ensure_topics / ensure_acls）。AWS の文書どおりなら、それまでは Topic authorization failed で書けず（MSK では未確認）、
# メッセージはキューで持って入ったら書く。
# キューの大きさや再送の設定は既定のまま（書けない間の振る舞いはこの既定で測った。tests/test_collectors.py）。メッセージは Telegraf の device_log の形:
#   name       device_log
#   tags       sysName（HOST）/ appname（PROGRAM）/ facility（local7 など）/ severity（err / notice など）/ source（送り元の IP）
#   fields     message（前後の空白を落とす）/ severity_code / facility_code（数値）/ procid / msgid / version（RFC5424 だけ。1）/
#              timestamp（機器が付けた時刻のナノ秒。S_UNIXTIME の秒に S_USEC のマイクロ秒と 000 を足す）
#   timestamp  受けた時刻の秒（Telegraf の json_timestamp_units = "1s" と同じ）
# 値の無いキー（RFC3164 の msgid、PID の無い行の procid）は出さない（--omit-empty-values。Telegraf も出さない）。
# Telegraf と違うのは facility 15 の名前（Telegraf は cron2、syslog-ng は solaris-cron）、本文の頭の空白（Telegraf は残す）、ヘッダーの壊れた行
# （Telegraf は捨て、syslog-ng は送り元の IP を sysName にして書く）。全部の severity と facility を送って比べた（docs/collection.md）
destination d_kafka {
  kafka-c(
    bootstrap-servers("__KAFKA_BROKERS__")
    topic("logs")
# >>> kafka_auth scram
    config(
      "security.protocol" => "SASL_SSL",
      "sasl.mechanism" => "SCRAM-SHA-512",
      "sasl.username" => "`KAFKA_SASL_USER`",
      "sasl.password" => "`KAFKA_SASL_PASS`"
    )
# <<< kafka_auth scram
    message("$(format-json --scope none --omit-empty-values
      name=device_log
      tags.sysName=$HOST
      tags.appname=$PROGRAM
      tags.facility=$FACILITY
      tags.severity=$LEVEL
      tags.source=$SOURCEIP
      fields.message=$(strip $MESSAGE)
      fields.severity_code=int64($LEVEL_NUM)
      fields.facility_code=int64($FACILITY_NUM)
      fields.procid=$PID
      fields.msgid=$MSGID
      __VERSION_PAIR__
      fields.timestamp=int64(${S_UNIXTIME}${S_USEC}000)
      timestamp=int64($R_UNIXTIME))")
  );
};

# ---- syslog-ng 自身のログ（起動・停止・Kafka に書けないなど）を標準出力へ（ECS はロググループ /ecs/<接頭辞>-syslog-ng）。
# notice 以上だけ。ヘルスチェックの tcp の接続ごとの行（Syslog connection accepted / closed）は -v を付けなければ出ない（4.29.0 で確かめた）
destination d_self { file("/dev/stdout" template("syslog-ng: ${LEVEL} ${MSG}\n")); };

log { source(s_device); destination(d_kafka); };
log {
  source { internal(); };
  filter { level(notice..emerg); };
  destination(d_self);
};
