# Spine-Leaf の DC ファブリック（IS-IS underlay + iBGP EVPN + VXLAN。すべて架空のアドレス）。app/containerlab/gen_lab.py が作る。**手で直さない**
# （python3 app/containerlab/gen_lab.py --leaves 2 --spines 2 で作り直す。既定の出力は tests/test_sync.py が確かめる）。
#
# これはテンプレート。__SRLINUX_IMAGE__ などは lab.sh render が ECR の URI に置き換えて splab.clab.yml を作る。
# スイッチは Nokia SR Linux（kind nokia_srlinux、type ixr-d2l = ライセンス不要。SR-MPLS にするときは ixr6e + ライセンス）。
# 設定は srlinux/<機器名>.cli（`set /` の行だけ。containerlab が candidate に流して commit save する）。
# SNMP（v2c、community public）と gNMI（57400、TLS）は containerlab が SR Linux で有効にする。SR Linux 6 台とも trap（linkDown / linkUp）と
# syslog の宛先を 203.0.113.1（この管理網の EC2 側）に向け、lab.sh forward がそれを Telegraf（ECS）の NLB へ DNAT する。
#
#               dc1-s-leaf-01 / dc1-s-leaf-02        （s-leaf。WAN 側）
#                          ╲  ╳  ╱
#                   dc1-spine-01 ... dc1-spine-0N        （full mesh。/31 + IS-IS）
#                          ╱  ╳  ╲
#               dc1-a-leaf-01 / dc1-a-leaf-02        （a-leaf。DC 側）
#   dc1-trex-01: eth1〜eth4 を各 leaf の e1-3 へ 1 本ずつ（leaf 側は mac-vrf の素の subinterface。LAG / ES は無い）
#
# 機器名は <site>-<role>-<連番2桁>（role = s-leaf / spine / a-leaf / trex）。SR Linux の host-name（= SNMP の sysName、syslog の
# hostname）も同じ値なので、collector は SNMP 側の sysName で機器を突き合わせられる。
# インタフェースは containerlab の endpoints では e1-N、SR Linux の設定と ifTable（ifName）では ethernet-1/N。lab_topology.py が読み替える。
name: splab

mgmt:
  # 名前と subnet を固定する（EC2 の中だけの docker network）。VPC からは Telegraf のタスクだけが、VPC のルートで lab の EC2 を経由して届く
  # （IaC/terraform/aws-managed/pipeline/lab の locals.tf の mgmt_cidr と lab.sh の MGMT が同じ subnet）
  network: nwc-lab
  ipv4-subnet: 203.0.113.0/24

topology:
  defaults:
    env:
      TZ: Asia/Tokyo

  kinds:
    nokia_srlinux:
      image: __SRLINUX_IMAGE__
      type: ixr-d2l

  nodes:
    # ---------- s-leaf（WAN 側） ----------
    dc1-s-leaf-01:
      kind: nokia_srlinux
      group: s-leaf
      mgmt-ipv4: 203.0.113.11
      startup-config: srlinux/dc1-s-leaf-01.cli

    dc1-s-leaf-02:
      kind: nokia_srlinux
      group: s-leaf
      mgmt-ipv4: 203.0.113.12
      startup-config: srlinux/dc1-s-leaf-02.cli

    # ---------- Spine（EVPN のルートリフレクタ） ----------
    dc1-spine-01:
      kind: nokia_srlinux
      group: spine
      mgmt-ipv4: 203.0.113.21
      startup-config: srlinux/dc1-spine-01.cli

    dc1-spine-02:
      kind: nokia_srlinux
      group: spine
      mgmt-ipv4: 203.0.113.22
      startup-config: srlinux/dc1-spine-02.cli

    # ---------- a-leaf（DC 側） ----------
    dc1-a-leaf-01:
      kind: nokia_srlinux
      group: a-leaf
      mgmt-ipv4: 203.0.113.31
      startup-config: srlinux/dc1-a-leaf-01.cli

    dc1-a-leaf-02:
      kind: nokia_srlinux
      group: a-leaf
      mgmt-ipv4: 203.0.113.32
      startup-config: srlinux/dc1-a-leaf-02.cli

    # ---------- TRex（linux。af_packet でポートを直接使うので privileged。本体は lab.sh trex start で起こす）----------
    dc1-trex-01:
      kind: linux
      image: __TREX_IMAGE__
      group: trex
      mgmt-ipv4: 203.0.113.101
      privileged: true
      exec:
        - ip link set eth1 up
        - ip link set eth2 up
        - ip link set eth3 up
        - ip link set eth4 up

  links:
    # fabric（spine - a-leaf / s-leaf の /31。SR Linux 側の e1-N は設定の ethernet-1/N）
    - endpoints: ["dc1-spine-01:e1-1", "dc1-s-leaf-01:e1-1"]   # 172.16.0.0/31 - 172.16.0.1/31
    - endpoints: ["dc1-spine-01:e1-2", "dc1-s-leaf-02:e1-1"]   # 172.16.0.2/31 - 172.16.0.3/31
    - endpoints: ["dc1-spine-01:e1-3", "dc1-a-leaf-01:e1-1"]   # 172.16.0.4/31 - 172.16.0.5/31
    - endpoints: ["dc1-spine-01:e1-4", "dc1-a-leaf-02:e1-1"]   # 172.16.0.6/31 - 172.16.0.7/31
    - endpoints: ["dc1-spine-02:e1-1", "dc1-s-leaf-01:e1-2"]   # 172.16.0.8/31 - 172.16.0.9/31
    - endpoints: ["dc1-spine-02:e1-2", "dc1-s-leaf-02:e1-2"]   # 172.16.0.10/31 - 172.16.0.11/31
    - endpoints: ["dc1-spine-02:e1-3", "dc1-a-leaf-01:e1-2"]   # 172.16.0.12/31 - 172.16.0.13/31
    - endpoints: ["dc1-spine-02:e1-4", "dc1-a-leaf-02:e1-2"]   # 172.16.0.14/31 - 172.16.0.15/31
    # TRex のポート（各 leaf へ 1 本）
    - endpoints: ["dc1-trex-01:eth1", "dc1-s-leaf-01:e1-3"]   # TRex port 0 (eth1) - dc1-s-leaf-01 mac-vrf
    - endpoints: ["dc1-trex-01:eth2", "dc1-s-leaf-02:e1-3"]   # TRex port 1 (eth2) - dc1-s-leaf-02 mac-vrf
    - endpoints: ["dc1-trex-01:eth3", "dc1-a-leaf-01:e1-3"]   # TRex port 2 (eth3) - dc1-a-leaf-01 mac-vrf
    - endpoints: ["dc1-trex-01:eth4", "dc1-a-leaf-02:e1-3"]   # TRex port 3 (eth4) - dc1-a-leaf-02 mac-vrf
