Content-Type: text/cloud-config; charset="us-ascii"
MIME-Version: 1.0

#cloud-config
cloud_final_modules:
- [scripts-user, always]

--==BOUNDARY==
Content-Type: text/x-shellscript; charset="utf-8"
MIME-Version: 1.0
Content-Transfer-Encoding: 8bit

#!/bin/bash
set -euo pipefail
APP=/opt/${name_prefix}-web
# /usr/bin/python3 は 3.9 のまま（AL2023 の仕様）。3.13 と pip を別に入れる。取得経路は S3 ゲートウェイエンドポイント
command -v python3.13 >/dev/null || dnf install -y python3.13 python3.13-pip
install -d -m 0755 $APP

# 画面のコード（app.py）・静的データ（data/）・依存の wheel（wheels/）を S3 から取る（ops/up.sh の手順 4）
aws s3 sync --delete --region ${region} s3://${bucket}/web/ $APP/src/

# Kafbat UI（cycle 010・014）。画面のコードの取得（上の s3 sync）より後、web/ がまだ無くて下で exit 0 する所より前に置く。Docker の取得経路も S3 ゲートウェイエンドポイント。
# この節は落ちても user_data を止めない（Gradio の画面を先に守る）。関数を || の左で呼ぶと中では set -e が効かないので、1 行ずつ || return 1 で繋ぐ。
# 落ちたら標準エラー（/var/log/cloud-init-output.log と journalctl -u cloud-final）に 1 行出して進む。logger は AL2023 に無いことがある（util-linux）ので使わない。
# 接続先は IaC/terraform/aws-managed/pipeline/stream の kafka_ui.tf が書く SSM のパラメータで、stream より先にこの EC2 ができる。
# パラメータが無い（ParameterNotFound。stream がまだ無い、SKIP_STREAM=1）ならスクリプトは 75 で終わり、systemd は成功の扱いにして（SuccessExitStatus）起こし直さない（RestartPreventExitStatus）。
# ユニットは inactive (dead) で止まり、failed に数えないので systemctl is-system-running は degraded にならない。
# それ以外で読めない（AccessDenied・エンドポイント不達・認証情報がまだ無い）なら 69 で終わり、30 秒ごとに起こし直す。
# 75 で止まったものは、下の Web のユニットの Wants= で、ops/up.sh の手順 8-3（OSS 版は 7-5）の systemctl restart <接頭辞>-web が起こす。
# 値はログに出さず、パスワードを含む env は /run（tmpfs）に置いて止まったら消す
kafka_ui_setup() {
  command -v docker >/dev/null || dnf install -y docker || return 1
  systemctl enable --now docker || return 1
  cat > /usr/local/bin/${name_prefix}-kafka-ui <<'__KAFKA_UI__' || return 1
#!/bin/bash
set -euo pipefail
umask 077
PARAM=/${name_prefix}/kafka-ui
ENV_FILE=/run/${name_prefix}-kafka-ui.env
ERR_FILE=/run/${name_prefix}-kafka-ui.err
param() {
  aws ssm get-parameter --region ${region} --name "$PARAM/$1" --query Parameter.Value --output text "$${@:2}" 2>"$ERR_FILE" && return 0
  if ! grep -qF '(ParameterNotFound)' "$ERR_FILE"; then
    echo "Cannot read $PARAM/$1 (not a missing parameter: e.g. AccessDenied, SSM endpoint unreachable, no credentials yet). Retrying in 30 s. AWS CLI:$(tr -s '\n' ' ' < "$ERR_FILE")" >&2
    exit 69
  fi
  echo "$PARAM/$1 does not exist (pipeline/stream is not applied, e.g. SKIP_STREAM=1). Not retrying; restarting ${name_prefix}-web (ops/up.sh does) or 'sudo systemctl start ${name_prefix}-kafka-ui' starts it again." >&2
  exit 75
}
IMAGE=$(param image) || exit $?
SERVERS=$(param bootstrap-servers) || exit $?
PROTOCOL=$(param security-protocol) || exit $?
PASSWORD=$(param admin-password --with-decryption) || exit $?
{
  printf '%s\n' "KAFKA_CLUSTERS_0_NAME=${name_prefix}" "KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=$SERVERS" \
    "KAFKA_CLUSTERS_0_PROPERTIES_SECURITY_PROTOCOL=$PROTOCOL"
  if [ "$PROTOCOL" = SASL_SSL ]; then
    printf '%s\n' "KAFKA_CLUSTERS_0_PROPERTIES_SASL_MECHANISM=AWS_MSK_IAM" \
      "KAFKA_CLUSTERS_0_PROPERTIES_SASL_CLIENT_CALLBACK_HANDLER_CLASS=software.amazon.msk.auth.iam.IAMClientCallbackHandler" \
      "KAFKA_CLUSTERS_0_PROPERTIES_SASL_JAAS_CONFIG=software.amazon.msk.auth.iam.IAMLoginModule required;"
  fi
  printf '%s\n' "AUTH_TYPE=LOGIN_FORM" "SPRING_SECURITY_USER_NAME=admin" "SPRING_SECURITY_USER_PASSWORD=$PASSWORD" \
    "GITHUB_RELEASE_INFO_ENABLED=false" "JAVA_OPTS=-XX:MaxRAMPercentage=50"
} > "$ENV_FILE"
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin "$${IMAGE%%/*}" >/dev/null
docker pull --quiet "$IMAGE"
docker rm --force ${name_prefix}-kafka-ui >/dev/null 2>&1 || true
exec docker run --rm --name ${name_prefix}-kafka-ui --env-file "$ENV_FILE" -p 127.0.0.1:8082:8080 "$IMAGE"
__KAFKA_UI__
  chmod 0755 /usr/local/bin/${name_prefix}-kafka-ui || return 1
  cat > /etc/systemd/system/${name_prefix}-kafka-ui.service <<__KAFKA_UI_UNIT__ || return 1
[Unit]
Description=${name_prefix} Kafbat UI (Docker, 127.0.0.1:8082, reached via SSM port forwarding)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/${name_prefix}-kafka-ui
ExecStopPost=/bin/rm -f /run/${name_prefix}-kafka-ui.env /run/${name_prefix}-kafka-ui.err
Restart=always
RestartSec=30
RestartPreventExitStatus=75
SuccessExitStatus=75
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
__KAFKA_UI_UNIT__
  systemctl daemon-reload || return 1
  systemctl enable --now ${name_prefix}-kafka-ui.service
}
kafka_ui_setup || echo "${name_prefix}-kafka-ui: setup failed (see the error above). Continuing with the web UI; fix it and reboot the instance." >&2

# バケットは IaC/terraform/aws-managed/base/core が作るので、初回の apply の時点では web/ が空。置いてから reboot-instances すれば、この user_data がもう一度走る
if [ ! -f $APP/src/requirements.txt ]; then
  echo "web/ is not in s3://${bucket} yet. Upload it (output upload_web_command) and reboot the instance." >&2
  exit 0
fi
# 置き間違いの検出。EC2 で動かすのは app/dashboard/app.py（Gradio の画面）だけ。app/agentcore/app.py（BedrockAgentCoreApp）は Runtime のコンテナの中でしか動かない
# （EC2 に置くと MODEL_ID の KeyError で落ちるか、画面が無いのでブラウザが 404 になる）
if ! grep -q "^import gradio" $APP/src/app.py; then
  echo "s3://${bucket}/web/app.py is not app/dashboard/app.py (no 'import gradio'). app/agentcore/app.py must not be placed here; it runs only inside the AgentCore Runtime container. Upload app/dashboard/app.py (output upload_web_command) and reboot the instance." >&2
  exit 1
fi
# インターネットに出ないので PyPI は見ない。wheel は arm64 / cp313 で揃えてある。--target で $APP/lib に入れる
python3.13 -m pip install --quiet --no-index --find-links $APP/src/wheels --target $APP/lib --upgrade \
  -r $APP/src/requirements%{ if graph_backend != "" }-oss%{ endif }.txt

# コメント以外に ASCII 以外の文字を書かない。cloud-init は MIME の 8bit の部分を raw-unicode-escape で取り出すので、
# 日本語は「運」がバックスラッシュ付きの u904b の形になり、systemd の EnvironmentFile がバックスラッシュを落として u904b になる（2026-10-05 に AWS で再現）。
# 画面のタイトルは app/dashboard/config.py の既定値（運用管理ダッシュボード）を使う
cat > /etc/${name_prefix}-web.env <<__ENV__
AWS_REGION=${region}
PORT=8080
DATA_DIR=$APP/src/data
PARAM_PREFIX=/${name_prefix}
PYTHONPATH=$APP/lib
GRADIO_TEMP_DIR=/var/lib/${name_prefix}-web/tmp
GRADIO_ANALYTICS_ENABLED=False
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
%{ if graph_backend != "" ~}
GRAPH_BACKEND=${graph_backend}
%{ endif ~}
__ENV__

# Wants= の Kafbat UI は、Web を start / restart するたびに（75 で止まっていても）一緒に起こされる。動いていれば何もしない。
# 弱い依存なので、Kafbat UI が落ちても無くても Web は止まらない（cycle 014。手元の systemd で実測）
cat > /etc/systemd/system/${name_prefix}-web.service <<__UNIT__
[Unit]
Description=${name_prefix} chat web (Gradio, 127.0.0.1:8080, reached via SSM port forwarding)
After=network-online.target
Wants=network-online.target
Wants=${name_prefix}-kafka-ui.service

[Service]
EnvironmentFile=/etc/${name_prefix}-web.env
ExecStart=/usr/bin/python3.13 $APP/src/app.py
DynamicUser=yes
StateDirectory=${name_prefix}-web
Environment=HOME=/var/lib/${name_prefix}-web
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
__UNIT__

systemctl daemon-reload
systemctl enable ${name_prefix}-web.service
systemctl restart ${name_prefix}-web.service
# 環境変数や依存の不足は起動の数秒後に落ちる。20 秒待って動いていなければ journald をこのログ（/var/log/cloud-init-output.log）に写す。
# 環境変数の並びはリポジトリの .env.example と同じ
sleep 20
if systemctl is-active --quiet ${name_prefix}-web.service; then
  echo "${name_prefix}-web.service is active (env: /etc/${name_prefix}-web.env)"
else
  echo "${name_prefix}-web.service is not active. Compare /etc/${name_prefix}-web.env with .env.example in the repo. journald follows:" >&2
  journalctl --no-pager -u ${name_prefix}-web.service -n 50 >&2
  exit 1
fi
--==BOUNDARY==--
