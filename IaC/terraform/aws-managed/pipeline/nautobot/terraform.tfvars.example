# Copy to terraform.tfvars only when the defaults are not right. Every value except owner has a default in variables.tf.
# ops/up.sh passes owner and nautobot_image_tag with -var. IaC/terraform/aws-managed/base/ecr and IaC/terraform/aws-managed/base/core must be applied first
# (this root reads their state files), and so must IaC/terraform/aws-managed/pipeline/stream and IaC/terraform/aws-managed/pipeline/graph when they are used.
# owner is the name of the person who deploys this copy and is REQUIRED: it has no default, so terraform asks for it
# unless you uncomment the line below (with your own name), export TF_VAR_owner or pass -var owner=<name>.
# Resource names and the Project tag become <owner>-nwc-poc (up to 14 lowercase letters, digits and single hyphens),
# so several people can share one AWS account.
#
# region      = "ap-northeast-1"
# owner       = "yamada"
#
# nautobot_image_tag  = "3.2.6"
# redis_image_tag     = "8.10.2-alpine"
# task_cpu            = 2048
# task_memory         = 4096
# db_instance_class   = "db.t4g.micro"
# db_engine_version   = "18"               # ops/up.sh passes POSTGRES_MAJOR (ops/up-common.sh)
# nautobot_db_az_num  = 1                # 1 or 2 (2 = Multi-AZ). ops/up.sh passes NAUTOBOT_DB_AZ_NUM
# deletion_protection = false
