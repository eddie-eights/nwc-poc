# 手元の構成（docker/compose）の設定。cp .env.example .env で写して使う（.env は git に入らない）。
# 値は手元だけで使う試し用の固定値（AWS にはつながない）。本物のシークレットは書かない。
# パスワードは Splunk（8 文字以上）と OpenSearch（大文字・小文字・数字・記号を含む 8 文字以上）の強度の条件を満たす形にしてある

# Splunk の admin（Web 127.0.0.1:8000 と管理 API 127.0.0.1:8089）
SPLUNK_PASSWORD=NwcLocal-Trial-2026!
# Splunk の HEC の token（Splunk が起動時に作り、spark-splunk が使う。ops/up.sh と同じ uuid の形）
SPLUNK_HEC_TOKEN=6f2b6a0e-0c1d-4e8a-9b3f-2d5c7e9a1b06
# OpenSearch の admin（127.0.0.1:9200。spark-http と Grafana が Basic 認証で使う）
OPENSEARCH_PASSWORD=NwcLocal-Trial-2026!
# Grafana の admin（127.0.0.1:3000）
GF_SECURITY_ADMIN_PASSWORD=NwcLocal-Trial-2026!

# lab のイメージ（./lab.sh が app/containerlab/lab.sh に渡す）。ops/lab-common.sh の SRLINUX_UPSTREAM:SRLINUX_TAG / MULTITOOL_UPSTREAM:MULTITOOL_TAG /
# TREX_UPSTREAM:TREX_TAG と同じ値（TRex は amd64 だけ）
SRLINUX_IMAGE=ghcr.io/nokia/srlinux:26.7.2
MULTITOOL_IMAGE=ghcr.io/srl-labs/network-multitool:v0.10.0
TREX_IMAGE=trexcisco/trex:2.41

# Splunk のアラートアクションと Grafana が読むリージョン（AWS には触らない）
AWS_REGION=ap-northeast-1
