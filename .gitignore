__pycache__/
*.pyc
.DS_Store
.env
.env.*
# 環境変数の一覧は残す（値は書かない）
!.env.example
# ops/up.sh・ops/down.sh の設定（deploy.env.example をコピーして書く）
deploy.env
# pip download の置き場（ops/up.sh の手順 4）
wheels/
# OSS 版（ops/oss/up.sh の手順 4-1。app/dashboard/requirements-oss.txt のぶん）
wheels-oss/
app/containerlab/splab.clab.yml
# containerlab が lab.sh up で作る（root の持ち物。docker/compose/README.md の「消す」）
app/containerlab/clab-*/
*.rpm
# uv の仮想環境
.venv/

# Terraform（state はローカル。消すと Terraform が作ったものを見失うので、このリポジトリのフォルダごと残す）
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
# OSS 版（cycle 005）のルートは oss.auto.tfvars で project = nwc-oss を入れる（値に秘密は無い）
!IaC/terraform/oss/**/oss.auto.tfvars
IaC/terraform/**/.build/
ops/logs/
*.part
# ops/up.sh の手順 5-3 で取る Spark の jar
jars/
# VS Code のワークスペース設定は各自の手元だけに置く
.vscode/
